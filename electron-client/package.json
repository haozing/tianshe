{
  "name": "chihu-electron-client",
  "private": true,
  "version": "2.1.6-phase0",
  "description": "Readable Electron client source for CHIHU remote web migration",
  "author": "赤狐管家",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "prepare:icons": "node scripts/create-windows-icon.js",
    "pack:win": "npm run prepare:icons && electron-builder --win --x64 --dir",
    "dist:win": "npm run prepare:icons && electron-builder --win --x64",
    "dist:win:portable": "npm run prepare:icons && electron-builder --win portable --x64",
    "smoke": "node scripts/run-smoke.js",
    "smoke:cookie": "node scripts/run-smoke.js cookie",
    "smoke:http": "node scripts/run-smoke.js http",
    "smoke:files": "node scripts/run-smoke.js files",
    "smoke:logs": "node scripts/run-smoke.js logs",
    "smoke:ui-contract": "node scripts/run-smoke.js ui-contract",
    "smoke:maintenance": "node scripts/run-smoke.js maintenance",
    "check:desktop-ui-manual-evidence": "node scripts/check-desktop-ui-manual-evidence.js",
    "check:desktop-ui-manual-ready": "node scripts/check-desktop-ui-manual-evidence.js --require-complete",
    "record:desktop-ui-manual-evidence": "node scripts/record-desktop-ui-manual-evidence.js",
    "check": "node scripts/check-syntax.js && node scripts/check-contract.js && node scripts/check-assets.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:contract": "node scripts/check-contract.js",
    "check:assets": "node scripts/check-assets.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  }
}
