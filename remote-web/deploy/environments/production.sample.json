{
  "schemaVersion": 1,
  "environment": "production",
  "releaseId": "2026.07.04.client-shell",
  "origins": {
    "newRemoteWebOrigin": "https://__REPLACE_WITH_NEW_REMOTE_WEB_ORIGIN__/",
    "remoteConfigUrl": "https://__REPLACE_WITH_NEW_REMOTE_WEB_ORIGIN__/new-remote-web/config/chihu-config.json",
    "remoteAssetsBase": "https://__REPLACE_WITH_NEW_REMOTE_WEB_ORIGIN__/",
    "diagnosticsUploadUrl": "https://__REPLACE_WITH_DIAGNOSTICS_UPLOAD_URL__/"
  },
  "cdn": {
    "rules": [
      {
        "name": "html-config-no-cache",
        "artifactCache": "no-cache",
        "appliesTo": ["remote-html", "chihu-config", "chihu-config-smoke", "doudian-adapter", "release-manifest"],
        "headers": { "cacheControl": "no-cache, no-store, must-revalidate", "maxAgeSeconds": 0 }
      },
      {
        "name": "short-js-css",
        "artifactCache": "short",
        "appliesTo": ["remote-js", "remote-css"],
        "headers": { "cacheControl": "public, max-age=300, must-revalidate", "maxAgeSeconds": 300 }
      },
      {
        "name": "hashed-assets",
        "artifactCache": "immutable-after-hash-build",
        "appliesTo": ["remote-asset"],
        "headers": { "cacheControl": "public, max-age=31536000, immutable", "maxAgeSeconds": 31536000 },
        "requiresHashOrCoexistence": true
      }
    ]
  },
  "retention": { "minimumRetainedPackages": 2, "rollbackTtlHours": 48 }
}
