{
  "schemaVersion": 1,
  "environment": "local",
  "releaseId": "2026.07.04.client-shell",
  "origins": {
    "newRemoteWebOrigin": "http://chihu-remote.localhost:4173/new-remote-web/",
    "remoteConfigUrl": "http://chihu-remote.localhost:4173/new-remote-web/config/chihu-config.json",
    "remoteAssetsBase": "http://chihu-remote.localhost:4173/",
    "diagnosticsUploadUrl": "http://chihu-remote.localhost:4173/__chihu-smoke-upload"
  },
  "cdn": {
    "rules": [
      {
        "name": "html-config-no-cache",
        "artifactCache": "no-cache",
        "appliesTo": [
          "remote-html",
          "chihu-config",
          "chihu-config-smoke",
          "doudian-adapter",
          "release-manifest"
        ],
        "headers": {
          "cacheControl": "no-cache, no-store, must-revalidate",
          "maxAgeSeconds": 0
        }
      },
      {
        "name": "short-js-css",
        "artifactCache": "short",
        "appliesTo": [
          "remote-js",
          "remote-css"
        ],
        "headers": {
          "cacheControl": "public, max-age=300, must-revalidate",
          "maxAgeSeconds": 300
        }
      },
      {
        "name": "hashed-assets",
        "artifactCache": "immutable-after-hash-build",
        "appliesTo": [
          "remote-asset"
        ],
        "headers": {
          "cacheControl": "public, max-age=31536000, immutable",
          "maxAgeSeconds": 31536000
        },
        "requiresHashOrCoexistence": true
      }
    ]
  },
  "retention": {
    "minimumRetainedPackages": 2,
    "rollbackTtlHours": 48
  }
}
