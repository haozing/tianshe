{
  "name": "@chihu/client-shell",
  "version": "2026.07.19-marketing-pilot-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:release": "npm test && npm run typecheck && npm run test:marketing-fixtures && npm run build && npm run obfuscate:release && npm run release:sync",
    "obfuscate:release": "node ../scripts/obfuscate-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "release:sync": "node ../scripts/update-release-manifest.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:store-state": "node --experimental-strip-types --test test/opportunity-store-state.test.mjs",
    "test:business-data-contract": "node --test test/business-data-xzb-contract.test.mjs",
    "test:marketing-fixtures": "node ../scripts/audit-doudian-marketing-fixtures.mjs",
    "test:marketing-real-fixtures": "node ../scripts/audit-doudian-marketing-fixtures.mjs --require-real",
    "generate:marketing-fixtures": "node ../scripts/generate-doudian-marketing-fixtures.mjs",
    "sync:marketing-read-pilot": "node ../scripts/sync-doudian-marketing-read-pilot.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@vitejs/plugin-react": "^4.6.0",
    "clsx": "^2.1.1",
    "json-bigint": "^1.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "javascript-obfuscator": "^4.2.2",
    "postcss": "^8.5.6",
    "typescript": "^5.8.3"
  }
}
